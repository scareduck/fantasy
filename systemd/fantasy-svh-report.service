[Unit]
Description=Fantasy Baseball pitcher SV+H tracker email report
After=network-online.target fantasy-game-log-sync.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/rlm/src/fantasy
Environment=PATH=/home/rlm/.local/bin:/usr/local/bin:/usr/bin:/usr/sbin
ExecStart=fantasy-svh-report --email
StandardOutput=journal
StandardError=journal
